# Copy to .env. All optional; defaults target the local docker postgres.
# To use Neon instead (apply db/schema.sql there first):
# DATABASE_URL=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
TZ=Europe/Rome
# Searches run on the host with the real Google Chrome: BROWSER_CHANNEL=chrome and HEADLESS=false
# (or just pass --chrome to the worker CLI). Docker uses Playwright's bundled headless Chromium.
# BROWSER_CHANNEL=chrome
HEADLESS=true
CRON_SEARCH=17 10 * * *      # one search session a day, at 10:17
CRON_MONITOR=30 6 * * *
# 1st of the month: consolidate last month, then generate the new cohort
CRON_CONSOLIDATE=0 5 1 * *
CRON_GENERATE=10 5 1 * *
# names per (registrar, action) group AND for the control group, per month
NAMES_PER_ARM=5
SEARCHES_PER_RUN=3
MIN_DELAY_SEC=10
MAX_DELAY_SEC=30
MONITOR_DAYS=90
CLEAR_CART=false
# Worker logging: debug | info | warn | error (log files go to data/logs/)
LOG_LEVEL=info
# LOG_FILE=false
