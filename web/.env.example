# Local development (copy to web/.env.local, git-ignored). On Vercel set the same variable in the project settings.
#
# Local Docker Postgres:
DATABASE_URL=postgres://frontrunning:frontrunning@localhost:15432/frontrunning
#
# Neon, read-only role, POOLED host (the one with "-pooler"):
# DATABASE_URL=postgresql://ro:PASSWORD@ep-xxxxxx-pooler.eu-central-1.aws.neon.tech/frontrunning?sslmode=verify-full
