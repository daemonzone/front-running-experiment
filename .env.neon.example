# Copy to .env.neon (git-ignored) and fill in. NEVER commit the real file: it holds a database password.
#
# Direct connection (host without "-pooler"): for the worker, backups and migrations.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx.REGION.aws.neon.tech/neondb?sslmode=require
#
# Pooled connection (host with "-pooler") and a read-only role: for the website on Vercel (set it there as DATABASE_URL).
# NEON_POOLED_URL=postgresql://RO_USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
